# Easy Track — Next.js frontend (P0) environment
# Copy to .env.local. All values here are PUBLIC (shipped to the browser).
#
# Firebase web config — defaults in lib/firebase.ts already match production
# (project easytrack-137d4), so these are optional overrides per environment.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDcnFOWldXptsrbAUoPnZqW7w2qYVf_YnQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=easytrack-137d4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=easytrack-137d4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=easytrack-137d4.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=976141198118
NEXT_PUBLIC_FIREBASE_APP_ID=1:976141198118:web:763607661ae0cccb0e57e7

# Launch preview gate (NOT security — see lib/preview.ts).
# Comma-separated emails allowed to see the new UI. Empty = closed to everyone.
# Use "*" to open to all signed-in users once ready for customers.
NEXT_PUBLIC_PREVIEW_ALLOWLIST=

# Free-trial launch date (ISO). Trial = 7 days from max(createdAt, this date).
# Missing/invalid → the trial banner shows nothing (fail-open, never "expired").
# Keep in sync with the backend TRIAL_LAUNCH_AT.
NEXT_PUBLIC_TRIAL_LAUNCH_AT=
